# ==============================================================================
# SupplyIQ — Environment Configuration Template
# ==============================================================================

# Neon Serverless PostgreSQL Database Connection String
# Format: postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-billowing-firefly-b3899ok9-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Database Connection Pool Settings (Tuned for Neon Serverless Pooled Endpoints)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# Machine Learning Model Artifact Location
MODEL_PATH=artifacts/model/model_v1.pkl
DEFAULT_SERVICE_LEVEL=0.95
DEFAULT_LEAD_TIME_DAYS=7

# Security & JWT Configuration
SECRET_KEY=replace-with-a-secure-random-256-bit-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Environment Mode (development | production | testing)
ENVIRONMENT=production
